# Copy to .env (local) or /etc/whatsapp-zoom-bot/env (server). Never commit the real file.
# All values below are dummies.

# --- Zoom Server-to-Server OAuth app (Zoom App Marketplace > your app > App credentials)
ZOOM_ACCOUNT_ID=dummy-account-id
ZOOM_CLIENT_ID=dummy-client-id
ZOOM_CLIENT_SECRET=dummy-client-secret
# Feature > Event subscriptions > Secret token
ZOOM_WEBHOOK_SECRET_TOKEN=dummy-webhook-secret
# The licensed Zoom user that hosts every meeting (email or user id)
ZOOM_HOST_USER=zoom-host@example.com

# --- Host key: set a new random key for each meeting and DM it to the requester
HOST_KEY_ROTATION=true

# --- WhatsApp (Baileys)
# Where the Baileys auth folder and the SQLite file live. Keep it outside the repo.
DATA_DIR=/var/lib/whatsapp-zoom-bot
# BAILEYS_AUTH_DIR=/var/lib/whatsapp-zoom-bot/baileys-auth
# Pair with a code instead of a QR: the bot's number, digits only, with country code
# WA_PAIRING_NUMBER=353870000000
# Only answer in these groups (comma-separated JIDs). Empty = any group the bot is in.
GROUP_JIDS=
# Who can start meetings, on top of group admins: JIDs or phone numbers, comma-separated
ALLOWLIST=
ALLOW_GROUP_ADMINS=true

# --- Database (defaults to $DATA_DIR/bot.sqlite)
# DB_PATH=/var/lib/whatsapp-zoom-bot/bot.sqlite

# --- Webhook server (Caddy proxies HTTPS to this)
HOST=127.0.0.1
PORT=3000
WEBHOOK_PATH=/zoom/webhook

# --- AI summaries (Anthropic Claude API). Off, or no key = transcript only.
SUMMARY_ENABLED=true
ANTHROPIC_API_KEY=sk-ant-dummy
SUMMARY_MODEL=claude-sonnet-5-5
SUMMARY_EFFORT=medium
SUMMARY_FALLBACKS=true
SUMMARY_MAX_CHARS=1500

# --- Lifecycle and retention
RECORDING_RETENTION_DAYS=7
# delete = permanent; trash = Zoom's trash (kept 30 days)
RECORDING_DELETE_ACTION=delete
EXPIRE_AFTER_MINUTES=120
MIN_INSTANCE_MINUTES=2
TRANSCRIPT_GIVE_UP_HOURS=24
# 86400 (24h), 604800 (7 days) or 2592000 (30 days)
PIN_SECONDS=86400
TIMEZONE=Europe/Dublin
DEFAULT_TITLE=Group call
LOG_LEVEL=info
