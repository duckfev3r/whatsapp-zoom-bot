{
  "name": "whatsapp-zoom-bot",
  "version": "0.1.0",
  "description": "WhatsApp group bot that starts Zoom meetings, pins the live link and posts AI summaries and transcripts",
  "license": "MIT",
  "author": "Benji Gogan",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "baileys@7.0.0-rc14": true
  }
}
